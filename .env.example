# =============================================================================
# Payments Service - Environment Configuration Example
# =============================================================================
# Copy this file to .env and adjust values for your environment
# cp .env.example .env

# =============================================================================
# Application Settings
# =============================================================================
ENVIRONMENT=dev
LOG_LEVEL=DEBUG
DEBUG=true

# =============================================================================
# Security
# =============================================================================
# API Key for authentication (X-API-Key header)
API_KEY=your-secret-api-key-here

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=payments

# Database URL (computed from above, or override directly)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# Message Broker (RabbitMQ)
# =============================================================================
BROKER_URL=amqp://guest:guest@rabbitmq:5672/
BROKER_PREFETCH_COUNT=10

# =============================================================================
# Retry Configuration
# =============================================================================
# TTL for retry queues (in milliseconds)
RETRY_TTL_LEVEL_1_MS=5000   # 5 seconds
RETRY_TTL_LEVEL_2_MS=10000  # 10 seconds
RETRY_TTL_LEVEL_3_MS=20000  # 20 seconds

# =============================================================================
# Payment Gateway Emulator
# =============================================================================
# Success rate: 0.0 (always fail) to 1.0 (always succeed)
GATEWAY_SUCCESS_RATE=0.9

# Response delay range (in seconds)
GATEWAY_MIN_DELAY_SECONDS=2.0
GATEWAY_MAX_DELAY_SECONDS=5.0

# =============================================================================
# Webhook Client
# =============================================================================
# HTTP timeout for webhook delivery (in seconds)
WEBHOOK_TIMEOUT_SECONDS=5.0

# Maximum number of webhook delivery attempts (before DLQ)
WEBHOOK_MAX_RETRIES=3

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]
